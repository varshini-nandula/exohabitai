# ==============================================================================
# ExoHabitAI Backend — Environment Configuration (EXAMPLE)
# ==============================================================================
# Copy this file to `.env` and update values for your environment.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_URL=sqlite:///exoplanets.db

# --- Model ---
MODEL_PATH=artifacts/habitability_pipeline.pkl

# --- Feature Defaults (for "mean" / "zero" default strategies) ---
FEATURE_DEFAULTS_PATH=artifacts/feature_defaults.json

# --- Security ---
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- Server ---
DEBUG=true

# --- ML Prediction ---
# Classification threshold (default 0.5). Set lower to favour recall,
# higher to favour precision.
THRESHOLD=0.5

# --- Retraining Safety ---
# Maximum tolerable F1-score drop when replacing a model.
# If new_f1 < (old_f1 - tolerance), old model is retained.
RETRAIN_F1_TOLERANCE=0.02

# --- Rate Limiting ---
# Minimum seconds between API calls per IP address.
RATE_LIMIT_SECONDS=1.0
